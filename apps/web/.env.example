# Copie para .env.local e preencha. NUNCA versione o arquivo real.
#
# Só variáveis VITE_ chegam ao navegador — e tudo que começa com VITE_ vai
# para o bundle público. Nunca coloque segredo aqui.
# A chave service_role do Supabase não deve existir neste projeto.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA-CHAVE-ANON
VITE_API_URL=http://localhost:3333
