# Copie para .env e preencha. NUNCA versione o .env.
# Nenhum valor real deve aparecer neste arquivo.

NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=debug

# Postgres local via `npm run db:up` na raiz do repositório.
# Em staging/produção vem do provedor, com credenciais próprias por ambiente.
DATABASE_URL=postgresql://natal:natal@localhost:5432/natal_dev
DATABASE_POOL_MAX=10
