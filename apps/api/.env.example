# Copie para .env e preencha. NUNCA versione o .env.
# Nenhum valor real deve aparecer neste arquivo.

NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=debug

# Postgres local via `npm run db:up` na raiz do repositório.
# Em staging/produção vem do provedor, com credenciais próprias por ambiente.
DATABASE_URL=postgresql://natal:natal@localhost:5432/natal_dev
DATABASE_POOL_MAX=10

# --- Autenticação (Fase 2) ---
# URL do projeto Supabase. Pública — aparece no bundle do frontend.
# Daqui saem o JWKS e o issuer esperado.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Nenhuma chave do Supabase é necessária aqui: a verificação usa o JWKS
# público. A service_role NÃO deve existir em lugar nenhum deste projeto.

# Origens autorizadas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# --- Testes de integração ---
# Banco DEDICADO a teste: o suite executa TRUNCATE. Nunca aponte para um
# banco compartilhado ou de produção. Ausente = testes de integração pulam.
# TEST_DATABASE_URL=postgresql://natal:natal@localhost:5432/natal_test
