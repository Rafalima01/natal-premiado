{
  "name": "@natal/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "migrate:up": "node --env-file-if-exists=.env scripts/migrate.mjs up",
    "migrate:down": "node --env-file-if-exists=.env scripts/migrate.mjs down",
    "migrate:status": "node --env-file-if-exists=.env scripts/migrate.mjs up --dry-run",
    "migrate:create": "node ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js create",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:financial": "node --env-file-if-exists=.env scripts/test-financial.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@natal/contracts": "*",
    "fastify": "^5.2.0",
    "jose": "^6.2.10",
    "pg": "^8.13.0",
    "uuid": "^14.0.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "node-pg-migrate": "^7.9.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
