{
  "name": "natal-premiado",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @natal/web",
    "dev:api": "npm run dev --workspace @natal/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "migrate:up": "npm run migrate:up --workspace @natal/api",
    "migrate:down": "npm run migrate:down --workspace @natal/api",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  }
}
